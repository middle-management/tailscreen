      "op": "json.inputEvent.decode",
      "in": {
        "json": "{\"mouseDown\":{\"x\":0.5,\"y\":0.5,\"button\":\"right\",\"modifiers\":9}}"
      },
      "out": {
        "event": {
          "kind": "mouseDown",
          "x": 0.5,
          "y": 0.5,
          "button": "right",
          "modifiers": 9
        }
      }
    },
