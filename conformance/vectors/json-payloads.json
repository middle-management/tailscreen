{
  "suite": "json-payloads",
  "description": "The JSON payloads carried inside TCP frames, in the decode direction \u2014 including the clamps and the rejections that are normative.",
  "spec": "docs/spec.md#102-payload-encodings",
  "cases": [
    {
      "id": "json/input-mouse-move",
      "requirements": [
        "TS-RMT-020"
      ],
      "op": "json.inputEvent.decode",
      "in": {
        "json": "{\"mouseMove\":{\"x\":0.25,\"y\":0.75}}"
      },
      "out": {
        "event": {
          "kind": "mouseMove",
          "x": 0.25,
          "y": 0.75
        }
      }
    },
